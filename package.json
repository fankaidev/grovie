{
  "name": "grovie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "grovie": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
